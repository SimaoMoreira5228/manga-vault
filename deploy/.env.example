# Required, database password for the postgres container and app connection URL.
POSTGRES_PASSWORD=

# Username of the account allowed to manage plugin repositories and sources.
# Leave empty to disable remote plugin management entirely.
ADMIN_USERNAME=

# Ollama endpoint for instance-wide chapter translation (self-hosted).
# Leave empty to disable translation unless users provide their own key.
OLLAMA_ENDPOINT=
OLLAMA_MODEL=qwen2.5:7b

# Master switch for the optional translation module. false disables every
# translation path, including per-user BYOK keys.
TRANSLATION_ENABLED=true

# 32-byte hex secret used to encrypt user-provided BYOK keys at rest.
# Required for users to store translation keys.
SECRET_KEY=

# Comma-separated exact origins allowed to call the API cross-origin.
# Leave empty for no CORS headers.
CORS_ORIGINS=

# Optional FlareSolverr endpoint (e.g. http://flaresolverr:8191/) for sources behind Cloudflare.
FLARESOLVERR_URL=
