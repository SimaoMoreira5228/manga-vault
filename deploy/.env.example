# Required, database password for the postgres container and app connection URL.
POSTGRES_PASSWORD=

# Username of the account allowed to manage plugin repositories and sources.
# Leave empty to disable remote plugin management entirely.
ADMIN_USERNAME=

# Comma-separated exact origins allowed to call the API cross-origin.
# Leave empty for no CORS headers.
CORS_ORIGINS=

# Optional FlareSolverr endpoint (e.g. http://flaresolverr:8191/) for sources behind Cloudflare.
FLARESOLVERR_URL=
