# === Required ===

# Encryption key for tracker/translation credentials.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Database URL. Two modes:
#
#   Shared postgres (recommended if you already run one):
#     DATABASE_URL=postgres://user:pass@127.0.0.1:5432/manga_vault
#
#   Standalone postgres (with --profile postgres):
#     DATABASE_URL=postgres://manga_vault:manga_vault@127.0.0.1:5433/manga_vault
DATABASE_URL=

# === Optional ===

# Username with plugin management access. Leave empty to disable.
ADMIN_USERNAME=

# Ollama endpoint for instance-wide chapter translation (self-hosted).
OLLAMA_ENDPOINT=
OLLAMA_MODEL=qwen2.5:7b

# Global kill switch for translation. false disables all translation paths.
TRANSLATION_ENABLED=true

# Memory cap (MB) for the in-memory tier of the proxied-image cache.
IMAGE_CACHE_MB=512

# Image cache backend: memory, disk, or hybrid (memory L1 plus disk L2).
IMAGE_CACHE_BACKEND=hybrid

# Disk tier budget (MB) and location for the proxied-image cache.
IMAGE_DISK_CACHE_MB=5120
IMAGE_CACHE_DIR=/data/image-cache

# Disk entries older than this (seconds) are refetched.
IMAGE_DISK_CACHE_TTL_SECS=86400

# Database pool sizing. Defaults are 5/1 for SQLite, 25/2 for Postgres.
DB_MAX_CONNECTIONS=
DB_MIN_CONNECTIONS=
DB_CONNECT_TIMEOUT_SECS=8
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=3600

# Worker tuning (worker process only).
SCHEDULER_WORKERS=4
SCHEDULER_BATCH_SIZE=16
SCHEDULER_POLL_SECS=30
SCHEDULER_STALE_AFTER_SECS=3600
SCHEDULER_STALE_BATCH_LIMIT=500

# Pre-instantiated component instances kept warm per WASM source.
WASM_PREWARM=2

# Redis URL for job dispatch and SSE fan-out across replicas.
# Unset keeps the single-node database queue and in-process events.
REDIS_URL=

# Byparr / FlareSolverr endpoint for sources behind Cloudflare.
FLARESOLVERR_URL=

# Comma-separated allowed origins.
CORS_ORIGINS=https://web.example.com

# API URL the web UI talks to (leave empty for same-origin).
PUBLIC_API_URL=

# Port to listen on (only used when network_mode is not host).
BIND_ADDR=0.0.0.0:18080

# Local plugin storage path inside the container.
PLUGINS_DIR=/plugins
